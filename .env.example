# Supabase — project tobclczszdikmgvkvngf (eu-central-1)
# The URL and the publishable/anon key are public-by-design: both ship inside
# the client bundle. NEVER put a service-role key or a JWT secret in a VITE_*
# variable — Vite inlines those into the bundle.
VITE_SUPABASE_URL=https://tobclczszdikmgvkvngf.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-from-dashboard-settings-api
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-from-dashboard-settings-api

# Server-only values (Supabase Edge Functions runtime; never exposed to Vite).
# Set these in Dashboard -> Edge Functions -> Secrets, not in a local .env file.
# OPENROUTER_API_KEY=
# LOVABLE_API_KEY=
