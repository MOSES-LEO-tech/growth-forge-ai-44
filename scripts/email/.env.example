# Email sending — Milestone
#
# Copy this file to scripts/email/.env and fill in ONE provider.
# scripts/email/.env is gitignored (.env* is ignored repo-wide) — never commit it.
# These are server-side secrets: do NOT prefix them with VITE_ (Vite would inline
# them into the browser bundle).

# ── Who the email comes from ────────────────────────────────────────────────
# Must be on a domain you have verified with the provider.
EMAIL_FROM="Milestone <hello@yourdomain.com>"
EMAIL_REPLY_TO=you@yourdomain.com

# ── Provider A: Resend (recommended) ────────────────────────────────────────
# 1. resend.com → Domains → Add Domain → add the DKIM/SPF records it shows
# 2. wait for status=verified (usually <15 min)
# 3. API Keys → Create (Sending access only)
RESEND_API_KEY=

# ── Provider B: SendGrid ────────────────────────────────────────────────────
# 1. sendgrid.com → Settings → Sender Authentication → verify a domain
# 2. Settings → API Keys → Create (Restricted: Mail Send only)
SENDGRID_API_KEY=

# Optional: force a provider when both keys are set (resend | sendgrid)
# EMAIL_PROVIDER=resend
